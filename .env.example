# Copy to .env. Mock mode does not require any key.
NADI9_MODE=mock
NADI9_MAX_MODEL_CALLS=25
NADI9_MAX_TOOL_CALLS=50
NADI9_DATA_DIR=data/raw
NADI9_OUTPUT_DIR=sample_run
NADI9_DB_PATH=data/processed/nadi9.sqlite

# Live mode only. Do not send Nadi-9 evidence to services that retain or train on data.
# OPENAI_API_KEY=
# NADI9_LLM_MODEL=gpt-4o-mini
